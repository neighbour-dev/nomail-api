      "TokenResponseEnvelope": {
        "type": "object",
        "required": ["code", "msg", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [0]
          },
          "msg": {
            "type": "string",
            "enum": ["success"]
          },
          "data": {
