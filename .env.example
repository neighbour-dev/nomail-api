# Use DATABASE_URL or the individual DB_* variables below.
# DATABASE_URL=postgres://postgres:password@localhost:5432/nomail
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=nomail

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=nomail-api
# Generate with: cargo run --bin gen-secret-key
SECRET_ENCRYPTION_KEY=base64-encoded-32-byte-key
PORT=3000
RUST_LOG=info

# Required only when the users table is empty. Remove the password after setup.
INITIAL_USERNAME=admin
INITIAL_PASSWORD=change-me-now1
